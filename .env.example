# DimKava Event Calendar (DEC)
# Copy to .env and fill in. Never commit .env.

APP_TIMEZONE=Asia/Tbilisi

# Jira Cloud — project DEC (DimKava Event Calendar), NOT DG
JIRA_URL=https://dimkavageorgia.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DEC
JIRA_ISSUE_TYPE=Task
# On Windows with corporate SSL MITM use false; on clean Linux containers prefer true
JIRA_SSL_VERIFY=true

# Telegram — swap bot/chat via env only (default: @prices_monitoring_alerts_bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISABLE_SSL_VERIFY=false

# Job
DRY_RUN=false
# Local (venv): ./data/alert_state.json
# Docker / server: /app/data/alert_state.json (volume-mounted)
IDEMPOTENCY_PATH=/app/data/alert_state.json
LOG_LEVEL=INFO

# Optional: override image on server (docker-compose.prod.yml)
# DEC_IMAGE=ghcr.io/ivanbondarenkoit/events-calendar:latest
